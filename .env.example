# Banco de Dados
# Use postgresql://usuario:senha@host:5432/banco para PostgreSQL externo / Neon
# Ou pglite://.data/pgdata para banco PostgreSQL 16 embarcado com pgvector local
DATABASE_URL="pglite://.data/pgdata"

# Segredo de Sessão / Assinatura (mínimo 32 caracteres)
AUTH_SECRET="dev-secret-key-alterar-em-producao-min-32-chars-2026"

# Armazenamento Privado de Arquivos ("local" ou "s3")
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH=".data/storage"
MAX_UPLOAD_BYTES="26214400"

# Provedor de IA Padrão ("extractive", "openai", "ollama")
AI_DEFAULT_PROVIDER="extractive"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Limites Operacionais e Workers
WORKER_CONCURRENCY="3"
WORKER_POLL_INTERVAL_MS="2000"
WORKER_JOB_TIMEOUT_MS="30000"
AI_DAILY_TOKEN_LIMIT_PER_USER="100000"

